{
  "name": "tenochca",
  "version": "1.0.0",
  "description": "Aztec-powered artist platform",
  "private": true,
  "workspaces": [
    "frontend",
    "contracts"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "start": "npm run start --workspace=frontend",
    "lint": "npm run lint --workspace=frontend",
    "test": "npm run test --workspace=contracts",
    "compile": "npm run compile --workspace=contracts",
    "deploy": "npm run deploy --workspace=contracts",
    "sandbox": "npm run sandbox --workspace=contracts",
    "ccc": "npm run compile --workspace=contracts && npm run codegen --workspace=contracts",
    "prepare": "husky install"
  },
  "devDependencies": {
    "husky": "^8.0.3",
    "@commitlint/cli": "^17.0.0",
    "@commitlint/config-conventional": "^20.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
